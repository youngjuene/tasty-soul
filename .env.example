# tasty-soul — 개발 환경 변수 템플릿
#
#   cp .env.example .env
#   # .env 에 키를 채운 뒤
#   ./scripts/setup.sh
#
# ─────────────────────────────────────────────────────────────────────────────
#  이 파일이 무엇이고 무엇이 아닌가
# ─────────────────────────────────────────────────────────────────────────────
#
#  §2 — "API 키는 OS 키체인(keyring)에 저장한다."
#  앱이 키를 읽는 **유일한** 출처는 OS 키체인이다. 이 파일이 아니다.
#
#  `.env` 는 키를 키체인에 **넣기 위한 투입구**일 뿐이다.
#  `scripts/setup.sh` 가 이 값을 읽어 `soul secrets import-env` 로 키체인에 옮기고,
#  그 뒤로 앱은 이 파일을 쳐다보지 않는다. 옮긴 뒤에는 지워도 된다.
#
#  키 저장소를 둘 두면 어느 쪽이 진실인지 알 수 없게 되고,
#  평문 파일 쪽이 조용히 이기게 된다. 그래서 한쪽만 진실로 둔다.
#
#  **`.env` 는 `.gitignore` 에 있다. 커밋하지 마라.**
#
# ─────────────────────────────────────────────────────────────────────────────


# ── API 키 ───────────────────────────────────────────────────────────────────

# 필수. 없으면 모든 투입 경로가 비활성화된다 (§15).
# https://platform.openai.com/api-keys
#
# macOS: 키체인에 넣을 때 승인 대화상자가 뜬다. 터미널에서 직접 실행하십시오
#        (비대화형 실행은 그 창을 누를 수 없어 멈춘다 — setup.sh 가 시간 상한을 건다).
OPENAI_API_KEY=

# 선택. `[search] provider` 가 duckduckgo(기본값)면 필요 없다.
# brave 또는 tavily 로 바꿀 때만 채운다 (docs/OPEN-DECISIONS.md #14).
SEARCH_API_KEY=

# 선택. YouTube Data API v3 (§9.3 단계 4).
# 없으면 카테고리를 못 얻어 kind 추정이 항상 `video` 로 고정된다 —
# 음원 영상도 프레임 30장을 뽑게 되므로 낭비다. 화면 2에서 한 탭으로 뒤집을 수는 있다.
YOUTUBE_API_KEY=


# ── 개발용 스위치 (앱 동작이 아니라 개발 편의) ───────────────────────────────

# 앱 데이터 루트를 덮어쓴다 (§3). 비워 두면 OS 기본 경로를 쓴다:
#   macOS   ~/Library/Application Support/tasty-soul/
#   Windows %APPDATA%\tasty-soul\
# 진짜 관측 로그를 건드리지 않고 시험하려면 여기에 임시 경로를 넣는다.
SOUL_ROOT=

# 네트워크가 필요한 테스트를 켠다. 기본 CI 경로는 완전 오프라인이다 (§17).
#   SOUL_E2E=1 cargo test --workspace -- --ignored
SOUL_E2E=

# 키체인 대신 위 환경변수에서 키를 읽는 것을 허용한다.
#
# **기본값은 꺼짐이고, 그대로 두는 것이 맞다.** 헤드리스 CI 처럼 Secret Service 가
# 없는 환경에서 E2E 를 돌릴 때만 쓴다. 켜면 평문 키가 프로세스 환경에 남는다.
SOUL_ALLOW_ENV_SECRETS=
