{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tasty-soul",
  "version": "0.1.0",
  "identifier": "app.tasty-soul.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "tasty-soul",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "dragDropEnabled": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
